---
import { Image } from 'astro:assets';
import { portraits } from '../content/story';
import SectionHeading from './SectionHeading.astro';

const positions = { center: 'object-center', top: 'object-top', bottom: 'object-bottom' };
---

<section class="py-16 md:py-24" aria-labelledby="portraits-heading">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading id="portraits-heading" flourish="Behind the counter">The craft and the room</SectionHeading>

    <ul data-portraits class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        portraits.map((portrait, index) => (
          <li data-reveal>
            <figure>
              <div
                data-portrait-frame
                class:list={[
                  'relative mb-5 mr-3 overflow-hidden rounded-[2rem] rounded-tr-none border-4 border-espresso-noir dark:border-text-light',
                  index % 2 === 0
                    ? 'shadow-[10px_10px_0_0_var(--color-mint-kulfi)]'
                    : 'shadow-[10px_10px_0_0_var(--color-teekaapi-orange)]',
                ]}
              >
                <Image
                  src={portrait.image}
                  alt={portrait.alt}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
                  class:list={['aspect-square w-full object-cover', positions[portrait.position]]}
                />
                <div class="grain absolute inset-0" aria-hidden="true"></div>
              </div>
              <figcaption class:list={['font-script text-2xl', index % 2 === 0 ? 'text-espresso-noir dark:text-mint-kulfi' : 'text-espresso-noir dark:text-teekaapi-orange']}>
                {portrait.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
