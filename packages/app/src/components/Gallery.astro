---
import { Image } from 'astro:assets';
import { categories, photos } from '../content/gallery';

const positions = { center: 'object-center', top: 'object-top', bottom: 'object-bottom' };
---

<div data-gallery>
  <div data-gallery-controls hidden class="mb-8">
    <div class="flex flex-wrap gap-2">
      {['All', ...categories].map((category) => (
        <button
          type="button"
          data-gallery-filter={category}
          aria-pressed={category === 'All'}
          class="min-h-11 rounded-full border-2 border-espresso-noir px-5 py-2 font-heading font-semibold aria-pressed:bg-teekaapi-orange aria-pressed:text-espresso-noir aria-pressed:underline aria-pressed:decoration-2 aria-pressed:underline-offset-4 dark:border-text-light"
        >{category}</button>
      ))}
    </div>
    <p data-gallery-status role="status" class="mt-3">All: {photos.length} photographs</p>
  </div>
  <ul data-gallery-list class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      photos.map((photo, index) => (
        <li data-category={photo.category} class="min-w-0 pb-2 pr-2">
          <div
            class:list={[
              'gallery-frame relative grid rounded-[2rem] rounded-tr-none border-4 border-espresso-noir dark:border-text-light',
              index % 2 === 0
                ? 'shadow-[8px_8px_0_0_var(--color-mint-kulfi)]'
                : 'shadow-[8px_8px_0_0_var(--color-teekaapi-orange)]',
            ]}
          >
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
              class:list={['col-start-1 row-start-1 aspect-square min-w-0 w-full rounded-[1.75rem] rounded-tr-none object-cover', positions[photo.position]]}
            />
            <div class="grain pointer-events-none absolute inset-0 rounded-[1.75rem] rounded-tr-none" aria-hidden="true"></div>
            <details class="relative col-start-1 row-start-1 min-w-0 self-end rounded-b-[1.75rem] bg-espresso-noir text-text-light">
              <summary data-gallery-title class="min-h-11 cursor-pointer list-inside rounded-b-[1.75rem] px-5 py-3 font-heading font-semibold">{photo.title}</summary>
              <p class="px-5 pb-5">{photo.description}</p>
            </details>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .gallery-frame:has(summary:hover),
  .gallery-frame:has(summary:focus-visible) {
    border-color: var(--color-teekaapi-orange);
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const controls = gallery?.querySelector<HTMLElement>('[data-gallery-controls]');
  const status = gallery?.querySelector<HTMLElement>('[data-gallery-status]');
  if (gallery && controls && status) {
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')];
    const cards = [...gallery.querySelectorAll<HTMLLIElement>('[data-gallery-list] > li')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const category = button.dataset.galleryFilter;
        let count = 0;
        for (const card of cards) {
          card.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((details) => { details.open = false; });
          card.hidden = category !== 'All' && card.dataset.category !== category;
          if (!card.hidden) count++;
        }
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        status.textContent = `${category}: ${count} photographs`;
      });
    }
    // Without successful initialization, the native gallery remains complete and usable.
    controls.hidden = false;
  }
</script>
