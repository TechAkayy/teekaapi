---
import { categories } from '../content/menu';
---

{/* The bar stays at the top of the window during scroll. It is a list of links, so it works without scripts. */}
<nav
  data-category-bar
  aria-label="Menu categories"
  class="sticky top-0 z-10 border-y-2 border-espresso-noir bg-cream-foam dark:border-text-light/30 dark:bg-charcoal-steam"
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <ul data-category-scroller class="category-scroller -mx-4 flex gap-2 overflow-x-auto px-4 py-3 md:mx-0 md:px-0">
      {
        categories.map((category, index) => (
          <li class="shrink-0">
            <a
              href={`#${category.id}`}
              data-category-link
              aria-current={index === 0 ? 'true' : 'false'}
              class="category-link block rounded-full border-2 border-espresso-noir px-4 py-2 font-heading font-semibold text-espresso-noir no-underline dark:border-text-light dark:text-text-light"
            >
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  @reference "../styles/global.css";

  .category-scroller {
    scrollbar-width: none;
  }
  .category-link[aria-current='true'] {
    @apply bg-espresso-noir text-text-light dark:bg-text-light dark:text-espresso-noir;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-category-bar]');
  const scroller = document.querySelector<HTMLElement>('[data-category-scroller]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-category-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-menu-category]')];

  if (bar && scroller && links.length > 0) {
    let shown = -1;

    // The category in view is the last one whose top has reached the bar.
    const sync = (): void => {
      const line = bar.getBoundingClientRect().bottom + 24;
      let current = 0;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= line) current = index;
      });
      // At the end of the page the last category is the one in view.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        const last = sections.at(-1);
        if (last && last.getBoundingClientRect().top < window.innerHeight) current = sections.length - 1;
      }
      if (current === shown) return;
      shown = current;
      links.forEach((link, index) => link.setAttribute('aria-current', String(index === current)));
      // The marked link stays in view inside the bar, without a scroll of the page.
      const link = links[current];
      if (link) {
        const target = link.offsetLeft - scroller.offsetLeft - (scroller.clientWidth - link.offsetWidth) / 2;
        scroller.scrollTo({ left: Math.max(0, target), behavior: 'instant' });
      }
    };

    let waiting = false;
    window.addEventListener(
      'scroll',
      () => {
        if (waiting) return;
        waiting = true;
        requestAnimationFrame(() => {
          waiting = false;
          sync();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', sync);
    sync();
  }
</script>
