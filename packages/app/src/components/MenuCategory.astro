---
import type { MenuCategory } from '../content/menu';
import MenuItem from './MenuItem.astro';

interface Props {
  category: MenuCategory;
  // Every second category sits on the alternate surface.
  alternate: boolean;
}

const { category, alternate } = Astro.props;
---

<section
  id={category.id}
  data-menu-category
  aria-labelledby={`${category.id}-heading`}
  class:list={[
    'scroll-mt-24 py-12 md:py-16',
    alternate && 'bg-filter-beige text-text-dark dark:bg-espresso-noir dark:text-text-light',
  ]}
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div data-reveal>
      <h2 id={`${category.id}-heading`} class="text-4xl tracking-tight md:text-5xl">{category.name}</h2>
      <p class="mt-2 text-lg">{category.line}</p>
    </div>

    <div class="mt-8 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        category.groups.map((group) => (
          <div>
            <h3 class="border-b-2 border-espresso-noir pb-2 text-sm uppercase tracking-widest dark:border-text-light">
              {group.name}
            </h3>
            <ul class="-mx-3 mt-3 md:-mx-4">
              {group.items.map((item) => <MenuItem item={item} />)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
