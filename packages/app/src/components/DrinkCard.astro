---
import { Image } from 'astro:assets';
import type { Drink } from '../content/home';

interface Props {
  drink: Drink;
  // The colour of the offset shadow behind the photograph.
  accent: 'orange' | 'mint';
}

const { drink, accent } = Astro.props;
const shadow =
  accent === 'orange'
    ? 'shadow-[8px_8px_0_0_var(--color-teekaapi-orange)]'
    : 'shadow-[8px_8px_0_0_var(--color-mint-kulfi)]';
const chipColour = drink.chip === 'Seasonal' ? 'bg-fusion-pink' : 'bg-mint-kulfi';
---

<li data-drink class="lift w-[78%] max-w-sm shrink-0 snap-start md:w-auto md:max-w-none">
  <div class="relative mb-5 mr-2">
    <Image
      src={drink.image}
      alt={drink.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 64rem) 16rem, (min-width: 48rem) 22rem, 78vw"
      class:list={['aspect-[4/5] w-full rounded-[2rem] object-cover', shadow]}
    />
    {
      drink.chip && (
        <span class:list={['absolute left-3 top-3 rounded-full px-3 py-1 text-sm font-semibold text-espresso-noir', chipColour]}>
          {drink.chip}
        </span>
      )
    }
  </div>
  <h3 class="text-xl">{drink.name}</h3>
  <p class="mt-1">{drink.description}</p>
</li>
