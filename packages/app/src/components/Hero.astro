---
import { Image } from 'astro:assets';
import { hero } from '../content/home';
import Button from './Button.astro';
---

<section class="hero relative isolate overflow-hidden bg-espresso-noir text-text-light" aria-labelledby="hero-heading">
  {/* Image component: https://docs.astro.build/en/reference/modules/astro-assets/ */}
  <Image
    src={hero.image}
    alt={hero.alt}
    widths={[640, 960, 1280, 2000]}
    sizes="100vw"
    priority
    class="absolute inset-0 -z-30 size-full object-cover"
  />
  {/* The overlay keeps the words readable over the photograph in both modes. */}
  <div
    class="absolute inset-0 -z-20 bg-linear-to-t from-espresso-noir via-espresso-noir/85 to-espresso-noir/40 md:bg-linear-to-r md:from-espresso-noir md:via-espresso-noir/85 md:to-espresso-noir/10"
    aria-hidden="true"
  >
  </div>
  <div class="grain absolute inset-0 -z-10" aria-hidden="true"></div>

  {/* Background shapes. They are decoration only. */}
  {/* A quarter disc in the corner. It stays inside the hero, so that it never sits behind the header. */}
  <div class="hero-shape absolute right-0 top-0 -z-10 size-32 rounded-bl-full bg-teekaapi-orange/80 md:size-36 lg:size-64" aria-hidden="true"></div>
  <div class="hero-shape hero-shape-slow absolute -bottom-10 right-1/4 -z-10 hidden h-40 w-80 rounded-t-full bg-fusion-pink/70 md:block" aria-hidden="true"></div>
  <div class="hero-shape absolute bottom-24 right-10 -z-10 hidden size-24 rounded-3xl border-4 border-mint-kulfi md:block" aria-hidden="true"></div>

  <div class="mx-auto flex min-h-[34rem] max-w-6xl flex-col justify-end gap-5 px-4 pb-14 pt-40 md:min-h-[40rem] md:justify-center md:px-6 md:py-24">
    <p class="font-script text-2xl text-mint-kulfi md:text-3xl">{hero.flourish}</p>
    <h1 id="hero-heading" class="max-w-xl wrap-anywhere text-5xl leading-[0.95] text-text-light md:text-7xl lg:max-w-3xl lg:text-8xl">
      {hero.headline}
    </h1>
    <p class="max-w-xl text-lg text-text-light md:text-xl">{hero.line}</p>
    <div class="flex flex-wrap items-center gap-4 pt-2">
      <Button href={hero.cta.href}>{hero.cta.label}</Button>
      <a href="/order/" class="inline-block rounded-full border-2 border-text-light px-6 py-3 font-heading text-lg font-semibold text-text-light no-underline">Try the booking preview</a>
    </div>
  </div>
</section>
