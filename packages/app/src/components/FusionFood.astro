---
import { Image } from 'astro:assets';
import { food } from '../content/home';
import SectionHeading from './SectionHeading.astro';
---

<section
  id="food"
  class="scroll-mt-4 bg-filter-beige py-16 text-text-dark dark:bg-espresso-noir dark:text-text-light md:py-24"
  aria-labelledby="food-heading"
>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:gap-16 md:px-6">
    <div data-reveal class="relative mb-3 mr-3">
      <Image
        src={food.image}
        alt={food.alt}
        widths={[480, 768, 1100]}
        sizes="(min-width: 48rem) 34rem, 92vw"
        class="aspect-[4/3] w-full rounded-[2.5rem] rounded-tr-none border-4 border-espresso-noir object-cover shadow-[12px_12px_0_0_var(--color-mint-kulfi)] dark:border-text-light"
      />
    </div>

    <div>
      <SectionHeading id="food-heading" flourish={food.flourish}>{food.heading}</SectionHeading>
      <p class="mt-3 max-w-prose text-lg">{food.intro}</p>

      <ul class="mt-8 space-y-5">
        {
          food.dishes.map((dish) => (
            <li data-reveal>
              <div class="flex items-baseline gap-3">
                <h3 class="text-xl">{dish.name}</h3>
                <span class="leader mb-1 flex-1 border-b-2 border-dotted border-espresso-noir/60 dark:border-text-light/60" aria-hidden="true" />
                <span class="text-sm font-semibold uppercase tracking-widest">{dish.tag}</span>
              </div>
              <p class="mt-1">{dish.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
