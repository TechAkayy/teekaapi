---
import Bowl from '@phosphor-icons/core/duotone/bowl-food-duotone.svg';
import Coffee from '@phosphor-icons/core/duotone/coffee-duotone.svg';
import Flame from '@phosphor-icons/core/duotone/flame-duotone.svg';
import Pin from '@phosphor-icons/core/duotone/map-pin-duotone.svg';
import type { Highlight } from '../content/home';

interface Props {
  highlight: Highlight;
}

const icons = { coffee: Coffee, bowl: Bowl, flame: Flame, pin: Pin };
const { highlight } = Astro.props;
const Icon = icons[highlight.icon];
---

<li
  data-reveal
  class="lift rounded-3xl border-2 border-espresso-noir bg-cream-foam p-5 text-text-dark dark:border-text-light/25 dark:bg-espresso-noir dark:text-text-light"
>
  <span class="grid size-12 place-items-center rounded-2xl bg-teekaapi-orange text-espresso-noir">
    <Icon class="size-7" fill="currentColor" aria-hidden="true" />
  </span>
  <h3 class="mt-4 text-lg">{highlight.title}</h3>
  <p class="mt-1 text-sm tracking-wide">{highlight.text}</p>
</li>
