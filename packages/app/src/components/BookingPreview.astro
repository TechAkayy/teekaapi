---
import { booking, services } from '../content/booking';
---

<div data-booking-preview class="min-w-0 self-start rounded-[2rem] rounded-tr-none border-2 border-espresso-noir p-5 sm:p-8 dark:border-text-light">
  <p data-preview-notice class="rounded-2xl bg-mint-kulfi p-4 font-heading font-semibold text-espresso-noir">{booking.notice}</p>
  <ol aria-label="Preview steps" class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-heading font-semibold">
    {['Date & time', 'Service', 'Review'].map((label, index) => (
      <li data-progress-step class="py-1 aria-[current=step]:underline aria-[current=step]:decoration-4 aria-[current=step]:decoration-fusion-pink aria-[current=step]:underline-offset-4">{index + 1}. {label}</li>
    ))}
  </ol>
  <p data-preview-fallback class="mt-6">{booking.fallback}</p>
  <div data-preview-controls hidden class="mt-8">
    <section data-preview-step="0">
      <h2 tabindex="-1" class="text-2xl">Date &amp; time</h2>
      <p id="preview-time-note" class="mt-3">{booking.timeNote}</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div class="min-w-0">
          <label for="preview-date" class="block font-heading font-semibold">Date</label>
          <input id="preview-date" type="date" required autocomplete="off" aria-describedby="preview-time-note preview-date-error" />
          <p id="preview-date-error" hidden class="mt-2 font-semibold"></p>
        </div>
        <div class="min-w-0">
          <label for="preview-time" class="block font-heading font-semibold">Time</label>
          <input id="preview-time" type="time" required step="60" autocomplete="off" aria-describedby="preview-time-note preview-time-error" />
          <p id="preview-time-error" hidden class="mt-2 font-semibold"></p>
        </div>
      </div>
      <button type="button" data-next class="preview-primary mt-6">Next</button>
    </section>
    <section data-preview-step="1" hidden>
      <h2 id="preview-service-heading" tabindex="-1" class="text-2xl">Service</h2>
      <fieldset aria-labelledby="preview-service-heading" class="mt-6 space-y-4">
        {services.map((service) => (
          <label class="flex cursor-pointer items-start gap-3 rounded-2xl border-2 border-espresso-noir p-4 dark:border-text-light">
            <input type="radio" name="preview-service" value={service.value} required aria-labelledby={`service-${service.value}`} aria-describedby={`description-${service.value} preview-service-error`} class="mt-1 size-5 shrink-0 accent-espresso-noir dark:accent-mint-kulfi" />
            <span class="min-w-0">
              <span id={`service-${service.value}`} class="block font-heading text-lg font-semibold">{service.label}</span>
              <span id={`description-${service.value}`} class="mt-1 block">{service.description}</span>
            </span>
          </label>
        ))}
      </fieldset>
      <p id="preview-service-error" hidden class="mt-3 font-semibold"></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" data-back class="preview-secondary">Back</button>
        <button type="button" data-next class="preview-primary">Next</button>
      </div>
    </section>
    <section data-preview-step="2" hidden>
      <div data-preview-review>
        <h2 tabindex="-1" class="text-2xl">Review</h2>
        <dl class="mt-6 space-y-4">
          <div><dt class="font-heading font-semibold">Date</dt><dd data-review-date></dd></div>
          <div><dt class="font-heading font-semibold">Time (Melbourne)</dt><dd data-review-time></dd></div>
          <div><dt class="font-heading font-semibold">Sample service</dt><dd data-review-service></dd></div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" data-back class="preview-secondary">Back</button>
          <button type="button" data-finish class="preview-primary">Finish preview</button>
        </div>
      </div>
      <div data-preview-result hidden>
        <h2 tabindex="-1" aria-describedby="preview-result-description" class="text-2xl">Preview complete</h2>
        <p id="preview-result-description" class="mt-4">Nothing was sent or saved. No booking or order was made.</p>
        <button type="button" data-reset class="preview-primary mt-6">Start again</button>
      </div>
    </section>
  </div>
</div>

<style>
  @reference "../styles/global.css";
  input[type='date'], input[type='time'] {
    @apply mt-2 block min-h-12 min-w-0 w-full rounded-xl border-2 border-espresso-noir bg-cream-foam px-3 py-2 text-espresso-noir dark:border-text-light dark:bg-charcoal-steam dark:text-text-light;
    color-scheme: light;
  }
  :global(.dark) input[type='date'], :global(.dark) input[type='time'] { color-scheme: dark; }
  .preview-primary, .preview-secondary {
    @apply min-h-11 rounded-full border-2 border-espresso-noir px-6 py-3 font-heading font-semibold;
  }
  .preview-primary { @apply bg-teekaapi-orange text-espresso-noir; }
  .preview-secondary { @apply dark:border-text-light; }
</style>

<script>
  import '../scripts/booking';
</script>
