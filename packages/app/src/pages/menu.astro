---
import DietaryMarks from '../components/DietaryMarks.astro';
import MenuCategory from '../components/MenuCategory.astro';
import MenuCategoryBar from '../components/MenuCategoryBar.astro';
import MenuSpecial from '../components/MenuSpecial.astro';
import { categories, dietaryKey } from '../content/menu';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Menu" description="The Teekaapi menu: coffee, cold brew and specials, fusion bites and desserts.">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-10 md:px-6 md:pt-16">
    <p class="font-script text-2xl text-espresso-noir dark:text-mint-kulfi">Pull up a chair</p>
    <h1 class="text-5xl md:text-7xl">Menu</h1>
    <p class="mt-3 max-w-prose text-lg">Specialty coffee and fusion food, from the first cup to the last bite.</p>
    <div class="mt-8">
      <MenuSpecial />
    </div>
  </div>

  <MenuCategoryBar />

  {categories.map((category, index) => <MenuCategory category={category} alternate={index % 2 === 1} />)}

  <section aria-labelledby="key-heading" class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <h2 id="key-heading" class="text-sm uppercase tracking-widest">Dietary key</h2>
    <dl data-dietary-key class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      {
        dietaryKey.map((entry) => (
          <div class="flex items-center gap-2">
            <dt><DietaryMarks marks={[entry.mark]} /></dt>
            <dd>{entry.meaning}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
