---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../content/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // A page that search engines must skip.
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Sets light or dark mode before the first paint, from the saved choice or from the device.
         https://tailwindcss.com/docs/dark-mode -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark = saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.add('js');
      })();
    </script>
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-pacifico" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-30 focus:rounded-full focus:bg-teekaapi-orange focus:px-5 focus:py-3 focus:font-heading focus:font-semibold focus:text-espresso-noir"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
