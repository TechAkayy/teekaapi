{
  "name": "@lets-vibe/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Private Vibe and Addy skill plugins with local structural validation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "files": [
    "plugins"
  ],
  "exports": {
    "./vibe-plugin": "./plugins/vibe/plugin.json",
    "./addy-plugin": "./plugins/addy/plugin.json"
  },
  "scripts": {
    "validate": "node --disable-warning=ExperimentalWarning tooling/validate-workspace.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tooling/tests/*.test.ts",
    "check": "pnpm validate && pnpm test && pnpm typecheck",
    "test:progress": "node --disable-warning=ExperimentalWarning --test tooling/tests/progress.test.ts",
    "progress": "node --disable-warning=ExperimentalWarning tooling/progress-report.ts",
    "typecheck": "tsc -p .",
    "run-report": "node --disable-warning=ExperimentalWarning tooling/run-report.ts"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "mdast-util-from-markdown": "2.0.3",
    "typescript": "7.0.2",
    "yaml": "2.8.3"
  }
}
